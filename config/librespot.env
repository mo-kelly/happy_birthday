# Konfiguration für librespot.service
# Wird nach /etc/default/librespot kopiert.

# Name, unter dem der Pi in der Spotify-App als Gerät erscheint
LIBRESPOT_NAME="ELEMAX"

# ALSA-Ausgabe -> immer "default", da dieser bereits den Tee (physisch + Loopback) enthält
LIBRESPOT_DEVICE="default"
LIBRESPOT_BACKEND="alsa"

# Bitrate: 96, 160 oder 320
LIBRESPOT_BITRATE="320"

# Start-Lautstärke in Prozent
LIBRESPOT_INITIAL_VOLUME="70"

# Zusätzliche Optionen, z.B. --enable-volume-normalisation
LIBRESPOT_EXTRA_OPTS=""
