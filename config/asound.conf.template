# ALSA-Basiskonfiguration für happy_birthday
# Wird von scripts/switch-audio-output.sh nach /etc/asound.conf geschrieben.
# Der Platzhalter {{PHYSICAL_PCM}} wird durch den Inhalt von
# physical-usb.conf.snippet oder physical-lan.conf.snippet ersetzt.

# --- physische Ausgabe (wird ersetzt) ---
{{PHYSICAL_PCM}}

# --- Loopback-Device für LedFx (Audioanalyse) ---
pcm.loopback_out {
    type hw
    card Loopback
    device 0
    subdevice 0
}

# --- Tee: gibt Audio gleichzeitig auf physical UND loopback_out aus ---
pcm.tee {
    type multi
    slaves.a.pcm "physical"
    slaves.a.channels 2
    slaves.b.pcm "loopback_out"
    slaves.b.channels 2
    bindings.0 { slave a; channel 0 }
    bindings.1 { slave a; channel 1 }
    bindings.2 { slave b; channel 0 }
    bindings.3 { slave b; channel 1 }
}

pcm.duptee {
    type route
    slave.pcm "tee"
    slave.channels 4
    ttable.0.0 1
    ttable.1.1 1
    ttable.0.2 1
    ttable.1.3 1
}

pcm.!default {
    type plug
    slave.pcm "duptee"
}

ctl.!default {
    type hw
    card 0
}
